{
  "manifest_version": 3,
  "name": "Colar Notas em Bloco",
  "version": "1.2",
  "description": "Cola notas da planilha em bloco em campos de nota.",

  "permissions": ["storage"],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
